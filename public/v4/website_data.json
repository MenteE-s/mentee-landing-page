  "v3_comparison": {
    "v3_mrr10": 0.103,
    "v4_mrr10": 0.252,
    "v3_miracl_en": 0.768,
    "v4_miracl_en": 0.916,
    "v3_miracl_ar": 0.447,
    "v4_miracl_ar": 0.874,
    "v3_miracl_ur": 0.354,
    "v4_miracl_ur": 0.572,
