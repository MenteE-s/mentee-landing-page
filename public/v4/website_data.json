    "cost_per_1b_sents_usd": 7.15,
    "batch_scaling": {
      "bs1": { "sents_per_sec": 145, "latency_ms": 6.9, "vram_mb": 174 },
      "bs8": { "sents_per_sec": 902, "latency_ms": 8.87, "vram_mb": 177 },
      "bs16": { "sents_per_sec": 1707, "latency_ms": 9.37, "vram_mb": 181 },
      "bs32": { "sents_per_sec": 3424, "latency_ms": 9.35, "vram_mb": 188 },
      "bs64": { "sents_per_sec": 6470, "latency_ms": 9.89, "vram_mb": 202 },
      "bs128": { "sents_per_sec": 12418, "latency_ms": 10.31, "vram_mb": 230 },
      "bs256": { "sents_per_sec": 20546, "latency_ms": 12.46, "vram_mb": 287 },
      "bs512": { "sents_per_sec": 22139, "latency_ms": 23.13, "vram_mb": 400 }
    },
    "precision": {
      "fp32": { "sents_per_sec_bs128": 12500, "vram_mb": 289 },
      "fp16": { "sents_per_sec_bs128": 3632, "vram_mb": 149 },
      "bf16": { "sents_per_sec_bs128": 2837, "vram_mb": 149 }
