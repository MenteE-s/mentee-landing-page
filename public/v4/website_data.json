{
  "model": "mentee-embed-v4",
  "version": "4",
  "params_M": 41,
  "embedding_dim": 384,
  "max_seq_len": 128,
  "languages": ["ar", "en", "ur"],
  "training_data": "~2.6M triplets",
  "initialization": "random (from scratch)",
  "architecture": "12-layer Transformer",
  "huggingface": "MenteEAI/mentee-embed-v4",
  "license": "apache-2.0",
  "trained_on": "RTX 5090",

  "benchmarks": {
    "custom_bench": {
      "description": "MenteE Embed Bench — 121 queries, 18 domains, dialect Arabic, Roman Urdu",
      "all_mrr10": 0.252,
      "all_ndcg10": 0.238,
      "all_r1": 0.083,
      "all_r5": 0.203,
      "all_r10": 0.273,
      "per_language": {
        "en": { "mrr10": 0.369, "ndcg10": 0.331, "r1": 0.131, "r5": 0.298, "r10": 0.405 },
        "ar": { "mrr10": 0.120, "ndcg10": 0.166, "r1": 0.025, "r5": 0.100, "r10": 0.175 },
        "ur": { "mrr10": 0.261, "ndcg10": 0.212, "r1": 0.090, "r5": 0.205, "r10": 0.231 }
      },
      "special": {
        "dialect_ar": { "mrr10": 0.095 },
        "roman_urdu": { "mrr10": 0.399 }
      }
    },
    "miracl": {
      "protocol": "A — In-batch retrieval",
      "en": { "acc1": 0.870, "mrr10": 0.916 },
      "ar": { "acc1": 0.825, "mrr10": 0.874 },
      "ur": { "acc1": 0.475, "mrr10": 0.572 }
    },
    "msmarco": {
      "protocol": "C — 10K passage retrieval",
      "mrr10": 0.706,
      "r5": 0.913,
      "r100": 0.980
