  "training_pipeline": [
    { "stage": 1, "name": "MLM Pretraining", "steps": 50000, "description": "Random init → masked language modeling on trilingual corpus" },
    { "stage": 2, "name": "Teacher Encoding", "description": "Encode all 2.6M triplets with multilingual-e5-base" },
    { "stage": 3, "name": "Distillation Round 1", "steps": 4000, "description": "InfoNCE contrastive + relational distillation" },
    { "stage": 4, "name": "Hard Negative Mining 1", "description": "GPU-accelerated top-5 mining across full corpus" },
    { "stage": 5, "name": "Distillation Round 2", "steps": 10000, "description": "Train with hard negatives" },
    { "stage": 6, "name": "Hard Negative Mining 2", "description": "Re-mine with improved model" },
    { "stage": 7, "name": "Distillation Round 3", "steps": 15000, "description": "Final polish on round-2 mined negatives" }
  ],

  "training_data_sources": [
    { "source": "all-NLI", "lang": "en", "triplets": 558000, "type": "NLI" },
    { "source": "XNLI", "lang": "ar", "triplets": 128000, "type": "NLI" },
    { "source": "XNLI", "lang": "ur", "triplets": 125000, "type": "NLI" },
    { "source": "OPUS-100 EN-UR", "lang": "en/ur", "triplets": 300000, "type": "Parallel" },
    { "source": "OPUS-100 AR-EN", "lang": "ar/en", "triplets": 300000, "type": "Parallel" },
    { "source": "MS-MARCO BM25", "lang": "en", "triplets": 500000, "type": "Retrieval" },
    { "source": "MS-MARCO hard neg", "lang": "en", "triplets": 200000, "type": "Retrieval" },
    { "source": "mMARCO Arabic", "lang": "ar", "triplets": 500000, "type": "Retrieval" },
    { "source": "MIRACL", "lang": "en/ar/ur", "triplets": 9000, "type": "Wikipedia" }
  ]
}
